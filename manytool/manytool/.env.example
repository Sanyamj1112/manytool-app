# ManyTool — Environment Variables
# Copy this file to .env and fill in your actual values

# ─── Supabase ───
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ─── Admin Dashboard ───
# Change this to a strong password before deploying
VITE_ADMIN_PASS=change_me_to_strong_password

# ─── Groq AI (SERVER-SIDE ONLY — set in Vercel environment variables, NOT here) ───
# NEVER put GROQ_API_KEY here with VITE_ prefix — it would be exposed in the browser
# Set GROQ_API_KEY in Vercel Dashboard → Settings → Environment Variables
# GROQ_API_KEY=your_groq_key_here  ← Vercel only, not VITE_

# ─── Note ───
# The old VITE_GROQ_API_KEY is intentionally removed.
# Groq API is now called server-side via /api/groq edge function.